{
  "request": {
    "urlPathTemplate": "/2.0/webhooks/{webhookId}/resetsharedsecret",
    "method": "POST",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/webhooks/reset-shared-secret/all-response-body-properties"
      },
      "x-request-id": {
        "matches" : ".*"
      }
    }
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "message": "SUCCESS",
      "resultCode": 0,
      "version": 1,
      "failedItems": [],
      "result": {
        "sharedSecret": "new123secret456value789abc012def345ghi678jkl901mno234pqr"
      }
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
