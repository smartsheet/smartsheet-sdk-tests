{
  "request": {
    "urlPathTemplate": "/2.0/webhooks/{webhookId}",
    "method": "DELETE",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/webhooks/delete-webhook/all-response-body-properties"
      },
      "x-request-id": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "message": "SUCCESS",
      "resultCode": 0,
      "version": 1,
      "failedItems": [
        {
          "rowId": 0,
          "error": {
            "refId": "abc123",
            "errorCode": 1234,
            "message": "Sample error message"
          },
          "index": 0
        }
      ]
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
