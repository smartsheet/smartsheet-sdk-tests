{
  "request": {
    "urlPathTemplate": "/2.0/users/{userId}/alternateemails",
    "method": "POST",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/users/alternate-emails/add-alternate-email/all-response-body-properties"
      },
      "x-request-id": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "message": "SUCCESS",
      "resultCode": 0,
      "data": [
        {
          "id": 9876543210987654,
          "confirmed": false,
          "email": "alternate.email@smartsheet.com"
        }
      ]
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
