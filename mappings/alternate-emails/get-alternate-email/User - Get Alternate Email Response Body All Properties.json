{
  "request": {
    "urlPathTemplate": "/2.0/users/{userId}/alternateemails/{alternateEmailId}",
    "method": "GET",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/users/alternate-emails/get-alternate-email/all-response-body-properties"
      },
      "x-request-id": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "id": 9876543210987654,
      "confirmed": true,
      "email": "alternate.email@smartsheet.com"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
