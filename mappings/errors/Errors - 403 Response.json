{
  "request": {
    "urlPathPattern": ".*",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/errors/403-response"
      },
      "x-request-id": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "statusMessage": "Forbidden",
    "status": 403,
    "jsonBody": {
      "errorCode": 1004,
      "message": "You are not authorized to perform this action.",
      "refId": "exlxshtxlpl8"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
