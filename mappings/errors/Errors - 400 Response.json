{
  "request": {
    "urlPathPattern": ".*",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/errors/400-response"
      },
      "x-request-id": {
        "matches" : ".*"
      }
    }
  },
  "response": {
    "statusMessage": "Malformed request",
    "status": 400,
    "jsonBody": {
      "errorCode": 1008,
      "message": "Malformed Request"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
