{
  "request": {
    "urlPathPattern": ".*",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/errors/429-html-response"
      },
      "x-request-id": {
        "matches" : ".*"
      }
    }
  },
  "response": {
    "statusMessage": "Too Many Requests",
    "status": 429,
    "body": "<html><head><title>429 Too Many Requests</title></head><body><h1>429 Too Many Requests</h1></body></html>",
    "headers": {
      "Content-Type": "text/html"
    }
  }
}
