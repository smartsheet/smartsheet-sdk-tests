{
  "request": {
    "urlPathTemplate": "/2.0/users/{userId}/profileimage",
    "method": "POST",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/users/add-profile-image/all-response-body-properties"
      },
      "x-request-id": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "message": "SUCCESS",
      "resultCode": 0,
      "data": [
        {
          "id": 12345678,
          "email": "test.user@smartsheet.com",
          "name": "Test User",
          "firstName": "Test",
          "lastName": "User",
          "profileImage": {
            "imageId": "u!1!nAtdn5RJB_o!k6_e_3h2R3w!wmYXPek-yVD",
            "height": 1050,
            "width": 1050
          }
        }
      ]
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
