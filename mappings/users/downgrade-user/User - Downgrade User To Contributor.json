{
  "request": {
    "urlPathTemplate": "/2.0/users/{userId}/plans/{planId}/downgrade",
    "method": "POST",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/users/downgrade-user/to-contributor"
      },
      "x-request-id": {
        "matches": ".*"
      }
    },
    "bodyPatterns": [
      {
        "equalToJson": "{\"seatType\":\"CONTRIBUTOR\"}"
      }
    ]
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "message": "SUCCESS",
      "resultCode": 0
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
