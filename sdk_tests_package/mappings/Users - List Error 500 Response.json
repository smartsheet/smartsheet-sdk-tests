{
  "request": {
    "urlPathPattern": ".*",
    "method": "GET",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/users/error-500-response"
      },
      "x-request-id": {
        "matches" : ".*"
      }
    }
  },
  "response": {
    "statusMessage": "Internal Server Error",
    "status": 500,
    "jsonBody": {
      "errorCode": 4000,
      "message": "Internal Server Error"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
